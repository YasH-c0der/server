# ==============================================================================
# drinkPure Production Environment Configuration Blueprint
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# CRITICAL: Must be set to 'production'.
# When set to 'production':
#   - Cookies enforce 'secure: true' (HTTPS only)
#   - Error handler masks raw database errors and internal stack traces
#   - Performance optimizations in Express & Mongoose are enabled
NODE_ENV=production

# The port Express listens on (often provided automatically by cloud platforms like Render/AWS)
PORT=5000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB ATLAS)
# ------------------------------------------------------------------------------
# Dedicated production cluster with strong credentials and write concern
# Format: mongodb+srv://<PROD_USER>:<PROD_PASSWORD>@<CLUSTER_HOST>/drinkpure_production?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://drinkpure_prod_user:ReplaceWithStrongProdDbPassword_9281@cluster0.pbtq1qp.mongodb.net/drinkpure_production?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. CORS & DOMAIN SECURITY (CRITICAL FOR COOKIES)
# ------------------------------------------------------------------------------
# CRITICAL SECURITY RULE:
# NEVER use wildcard '*' in production when using HTTP-only cookies!
# Browsers strictly block cookies and throw CORS errors if Access-Control-Allow-Origin is '*' with credentials.
# List all your production domains separated by commas (no trailing slash):
CORS_ORIGIN=https://drinkpure.in,https://www.drinkpure.in,https://corporate.drinkpure.in,https://admin.drinkpure.in

# ------------------------------------------------------------------------------
# 4. JSON WEB TOKEN (JWT) SECURITY
# ------------------------------------------------------------------------------
# Must be a cryptographically secure 256-bit or 512-bit random string.
# Generate in terminal using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER commit or hardcode this value.
JWT_SECRET=e7b4f8c92a1d3e5f60b7c8d9a0e1f2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. UPCOMING PRODUCTION INTEGRATIONS (FUTURE STEPS)
# ------------------------------------------------------------------------------
# SMS Provider (e.g. Fast2SMS / MSG91 / Twilio) to dispatch real OTPs
# SMS_GATEWAY_API_KEY=your_sms_gateway_key_here
# SMS_SENDER_ID=DRNKPR

# Cloud Storage (AWS S3 / Cloudinary) for product images and dark store assets
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_key
# CLOUDINARY_API_SECRET=your_cloudinary_secret

# Payment Gateway (Razorpay / Cashfree)
# RAZORPAY_KEY_ID=rzp_live_your_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_secret
